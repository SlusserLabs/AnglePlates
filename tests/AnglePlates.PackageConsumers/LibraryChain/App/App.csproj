<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>11.0</LangVersion>
    <AnglePlatesPackageVersion Condition="'$(AnglePlatesPackageVersion)' == ''">0.0.0-local</AnglePlatesPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Library\Library.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- This project doesn't reference AnglePlates, so discovery must not reach it -->
  <Target Name="CheckNoAnglePlateItems" BeforeTargets="CoreCompile">
    <Error Condition="'@(AnglePlate)' != ''" Text="LibraryChain failed: AnglePlate items flowed to the app: @(AnglePlate)" />
  </Target>
</Project>
