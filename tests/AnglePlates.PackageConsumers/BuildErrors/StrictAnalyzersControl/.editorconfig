root = true

[*.cs]
dotnet_diagnostic.IDE0055.severity = warning
dotnet_analyzer_diagnostic.category-Style.severity = warning
# The generated namespaces are file-scoped, so this preference deliberately disagrees with them
csharp_style_namespace_declarations = block_scoped:warning
csharp_prefer_braces = true:warning
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning
csharp_style_var_elsewhere = false:warning

# Only the consumer's own file is relaxed; generated files (*.g.cs) face every rule above
[Program.cs]
# Silenced for this top-level-statements file only:
#   SA1633 and SA1200: no file header, and usings can't move into a namespace in top-level code
#   IDE0090: the explicit types that the var settings demand conflict with target-typed new
#   CA1303: a console message is a plain literal, not localized text
#   SA1516: StyleCop 1.1.118 reports adjacent top-level statements as elements without a blank line
dotnet_diagnostic.SA1633.severity = none
dotnet_diagnostic.SA1200.severity = none
dotnet_diagnostic.IDE0090.severity = none
dotnet_diagnostic.CA1303.severity = none
dotnet_diagnostic.SA1516.severity = none
