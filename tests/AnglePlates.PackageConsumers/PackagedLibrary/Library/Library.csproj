<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>11.0</LangVersion>
    <AnglePlatesPackageVersion Condition="'$(AnglePlatesPackageVersion)' == ''">0.0.0-local</AnglePlatesPackageVersion>

    <!-- eng/validate-package.ps1 packs this library into a folder the app restores from. -->
    <PackageId>PackagedLibrary.Library</PackageId>
    <Version>1.0.0</Version>

    <!-- The app renders a template from this package, so the support types and that template are public. -->
    <AnglePlateBaseAccessModifier>public</AnglePlateBaseAccessModifier>
  </PropertyGroup>
  <ItemGroup>
    <!-- PrivateAssets keeps AnglePlates out of this package's dependencies. -->
    <PackageReference Include="SlusserLabs.AnglePlates" Version="$(AnglePlatesPackageVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
