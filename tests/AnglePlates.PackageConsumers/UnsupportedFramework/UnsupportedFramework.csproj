<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Older than the .NET 10 that AnglePlates supports; eng/validate-package.ps1 expects this build to fail with exactly ExpectedErrors.txt -->
    <TargetFramework>net8.0</TargetFramework>
    <!-- Keeps the exact check stable once SDKs flag net8.0 as out of support with NETSDK1138 -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>11.0</LangVersion>
    <AnglePlatesPackageVersion Condition="'$(AnglePlatesPackageVersion)' == ''">0.0.0-local</AnglePlatesPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SlusserLabs.AnglePlates" Version="$(AnglePlatesPackageVersion)" PrivateAssets="all" />
  </ItemGroup>
</Project>
