<Project>
  <!-- Directory.Build.props is imported before the package props, and MSBuild evaluates every property before any item, so this switch turns the default Templates folder off -->
  <PropertyGroup>
    <EnableDefaultAnglePlateItems>false</EnableDefaultAnglePlateItems>
  </PropertyGroup>

  <!-- This Remove runs before the project file includes Emails, so it has no effect and the welcome template still generates -->
  <ItemGroup>
    <AnglePlate Remove="Emails\welcome.html" />
  </ItemGroup>
</Project>
