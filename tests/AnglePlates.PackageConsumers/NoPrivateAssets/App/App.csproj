<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>11.0</LangVersion>
    <AnglePlatesPackageVersion Condition="'$(AnglePlatesPackageVersion)' == ''">0.0.0-local</AnglePlatesPackageVersion>

    <!-- Support types generated here would collide with the library's public ones as CS0436 warnings -->
    <WarningsAsErrors>$(WarningsAsErrors);CS0436</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Library\Library.csproj" />
  </ItemGroup>

  <!-- The library's reference has no PrivateAssets, but the package's discovery files are under build/, so they must not reach this project -->
  <Target Name="CheckNoAnglePlateItems" BeforeTargets="CoreCompile">
    <Error Condition="'@(AnglePlate)' != ''" Text="NoPrivateAssets failed: AnglePlate items flowed to the app: @(AnglePlate)" />
  </Target>
</Project>
