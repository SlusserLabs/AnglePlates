<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SlusserLabs.AnglePlates.PackageTests</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>11.0</LangVersion>
    <AnglePlatesPackageVersion Condition="'$(AnglePlatesPackageVersion)' == ''">0.0.0-local</AnglePlatesPackageVersion>
    <AnglePlateBaseAccessModifier>internal</AnglePlateBaseAccessModifier>
    <AnglePlateViews>$(ProjectDir)CustomViews</AnglePlateViews>
    <AnglePlateExclude>$(ProjectDir)Templates\excluded.html</AnglePlateExclude>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SlusserLabs.AnglePlates" Version="$(AnglePlatesPackageVersion)" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <AnglePlate Include="Explicit\explicit.html" />
    <AnglePlate Include="Templates\package.html" />
  </ItemGroup>
</Project>
