<Project Sdk="Microsoft.NET.Sdk">

  <!-- Identity: the assembly name, package ID, and root namespace stay SlusserLabs.AnglePlates whatever the folder is called -->
  <PropertyGroup>
    <AssemblyName>SlusserLabs.AnglePlates</AssemblyName>
    <PackageId>SlusserLabs.AnglePlates</PackageId>
    <RootNamespace>SlusserLabs.AnglePlates</RootNamespace>
  </PropertyGroup>

  <!-- Package metadata shown on nuget.org -->
  <PropertyGroup>
    <Title>AnglePlates</Title>
    <Description>Text templates that compile into plain C# classes at build time. There's no runtime package and no reflection, so your templates work with Native AOT.</Description>
    <Authors>Jacob Slusser</Authors>
    <Copyright>Copyright (c) 2026 SlusserLabs, Jacob Slusser. All rights reserved.</Copyright>
    <PackageTags>templates;template-engine;text-templates;source-generator;roslyn;codegen;html;utf8;aot;trimming</PackageTags>
    <PackageProjectUrl>https://github.com/SlusserLabs/AnglePlates</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/SlusserLabs/AnglePlates/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Analyzer packaging: a development dependency with the generator under analyzers/ and no runtime assets or dependencies -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <BuildOutputTargetFolder>analyzers/dotnet/cs</BuildOutputTargetFolder>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <!-- Build: netstandard2.0 and Roslyn 4.14.0 are the oldest compiler host a supported consumer can use. The .NET
       analyzers aren't on by default for netstandard2.0, so they're turned on here. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    <!-- build/ applies the props and targets only to the project that references AnglePlates, where the generator runs -->
    <None Update="build\SlusserLabs.AnglePlates.props" Pack="true" PackagePath="build\SlusserLabs.AnglePlates.props" />
    <None Update="build\SlusserLabs.AnglePlates.targets" Pack="true" PackagePath="build\SlusserLabs.AnglePlates.targets" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AnglePlates.Tests" />
  </ItemGroup>

</Project>
