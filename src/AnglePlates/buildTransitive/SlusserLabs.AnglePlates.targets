<Project>

  <Target Name="CollectAnglePlateTemplates" BeforeTargets="GenerateMSBuildEditorConfigFile">
    <ItemGroup>
      <AnglePlate Include="$(AnglePlateTemplates)\**\*" Exclude="$(AnglePlateExclude)" Condition="Exists('$(AnglePlateTemplates)')" />
      <AnglePlate Include="$(AnglePlateViews)\**\*" Exclude="$(AnglePlateExclude)" Condition="Exists('$(AnglePlateViews)')" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(AnglePlate)">
      <Output TaskParameter="Filtered" ItemName="_DistinctAnglePlate" />
    </RemoveDuplicates>
    <ItemGroup>
      <AdditionalFiles Include="@(_DistinctAnglePlate)" />
    </ItemGroup>
  </Target>

</Project>
