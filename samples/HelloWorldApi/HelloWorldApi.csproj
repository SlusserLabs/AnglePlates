<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Import the package assets in the same order as the console sample -->
  <Import Project="..\..\src\AnglePlates\build\SlusserLabs.AnglePlates.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>11</LangVersion>
    <RootNamespace>SlusserLabs.AnglePlates.Samples.HelloWorldApi</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AnglePlates\AnglePlates.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Import Project="..\..\src\AnglePlates\build\SlusserLabs.AnglePlates.targets" />
</Project>
